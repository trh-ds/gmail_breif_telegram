# Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Telegram (@BotFather token, @userinfobot chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Path to Google OAuth "Desktop app" client secret
GMAIL_CREDENTIALS_PATH=credentials.json

# Hosted only (Vercel): paste full contents of token.json here instead of using files
# GMAIL_TOKEN_JSON=
# Vercel-only: writable paths + cron auth
# SEEN_CACHE_PATH=/tmp/seen_ids.json
# LOG_PATH=/tmp/briefing.log
# CRON_SECRET=

# Optional: any chat model from https://console.groq.com/docs/models
# GROQ_MODEL=openai/gpt-oss-120b
